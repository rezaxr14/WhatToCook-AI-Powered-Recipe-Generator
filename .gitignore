# ========================================================
# WhatToCook Comprehensive GitIgnore Rules
# ========================================================

# Python Cache, Bytecode & Virtual Environments
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# Environment Configuration Files
.env
.env.local
.env.*.local
!.env.example

# Node Dependencies & Build Outputs
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Storage
!db.sqlite3
*.sqlite3
*.db

# Screenshots, Test Outputs & Temp Media
artifacts_screenshots/
test-results/
.tempmediaStorage/
playwright-report/

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
